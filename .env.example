# --- LLM (scoring) ---
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=xiaomi/mimo-v2.6-flash
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- SMTP (rapport quotidien) ---
#
# BREVO (300 emails/jour gratuits) :
#   SMTP_HOST      = smtp-relay.brevo.com
#   SMTP_PORT      = 587      (ou 465 + SECURITY=ssl, ou 2525)
#   SMTP_LOGIN     = la valeur du champ « Login » de Brevo
#                    Settings > SMTP & API > onglet SMTP
#                    ⚠️ ce n'est PAS smtp-relay.brevo.com, ni forcément ton email
#   SMTP_PASS      = clé SMTP générée dans ce même onglet
#                    (Settings > SMTP & API > Generate a new SMTP key)
#                    ⚠️ PAS la clé API v3 (xkeysib-…)
#   MAIL_FROM      = une adresse vérifiée
#                    Settings > Senders, Domains & IPs > Senders
#
# GMAIL (alternative, ~2 min) :
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURITY=ssl
#   SMTP_LOGIN/SMTP_USER = ton adresse gmail (identique à MAIL_FROM)
#   SMTP_PASS = mot de passe d'application 16 caractères
#               myaccount.google.com/apppasswords (2FA obligatoire)
#
# SMTP_USER est accepté à la place de SMTP_LOGIN.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_LOGIN=votre-login-brevo
SMTP_PASS=xxxxx
MAIL_FROM=adresse-verifiee@mail.com
MAIL_TO=destinataire@mail.com
MAIL_CC=personne-en-copie@mail.com
